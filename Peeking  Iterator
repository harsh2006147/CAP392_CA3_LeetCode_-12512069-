
class PeekingIterator : public Iterator {
private:
    int nextElement;
    bool hasElement;

public:
    PeekingIterator(const vector<int>& nums) : Iterator(nums) {
        hasElement = Iterator::hasNext();

        if (hasElement) {
            nextElement = Iterator::next();
        }
    }

    int peek() {
        return nextElement;
    }

    int next() {
        int result = nextElement;

        hasElement = Iterator::hasNext();

        if (hasElement) {
            nextElement = Iterator::next();
        }

        return result;
    }

    bool hasNext() const {
        return hasElement;
    }
};
